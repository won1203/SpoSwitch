<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 시스템 스플래시: 커스텀 로딩화면과 같은 배경/로고로 통일 -->
    <style name="Theme.SpoSwitch.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">#6E4B2E</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
